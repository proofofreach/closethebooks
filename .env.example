# Copy to <workspace>/.env (gitignored). `books` reads it at startup;
# variables already set in the shell take precedence.

# Plaid bank feeds. Start with sandbox, then switch to production after the
# live Trial application is approved in the Plaid dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Only for the command-line `xero-backup` tool. The app's Move from Xero page
# stores its Xero app details in <workspace>/secrets/xero/ instead.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8766/callback
XERO_SCOPES=
XERO_TENANT_ID=
XERO_DAILY_CALL_FLOOR=25
